{
  "name": "monoindustrial",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#2D3A35",
    "editor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#A2A9A566",
    "editor.lineHighlightBackground": "#0D0F0D40",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#797F7B80"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#2D3A35"
      }
    },
    {
      "settings": {
        "foreground": "#797F7B",
        "background": "#1B2521"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#CF5000"
      },
      "name": "Type",
      "scope": [
        "storage",
        "support.type"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#1B2521"
      },
      "name": "Embedded code",
      "scope": [
        "string.unquoted.embedded",
        "text source",
        "string.unquoted"
      ]
    },
    {
      "settings": {
        "foreground": "#F05E0000",
        "background": "#230600"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "string source - string.unquoted.embedded",
        "string string source"
      ]
    },
    {
      "settings": {
        "foreground": "#CF4D00",
        "background": "#230600"
      },
      "name": "String",
      "scope": [
        "string - string source",
        "string source string",
        "meta.scope.heredoc"
      ]
    },
    {
      "settings": {
        "foreground": "#EF9A00"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#769FDB"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#EF9A00"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#B6C0B9",
        "background": "#1C2622"
      },
      "name": "Preprocessor line",
      "scope": "other.preprocessor"
    },
    {
      "settings": {
        "foreground": "#B6C0B9",
        "background": "#1C2622"
      },
      "name": "Preprocessor directive",
      "scope": "entity.name.preprocessor"
    },
    {
      "settings": {
        "foreground": "#B6C0B9"
      },
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "keyword.operator",
        "keyword.other.name-of-parameter"
      ]
    },
    {
      "settings": {
        "foreground": "#AC4100"
      },
      "name": "Class name",
      "scope": "entity.name.class"
    },
    {
      "settings": {
        "foreground": "#769FDB"
      },
      "name": "Function parameter",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#797F7B"
      },
      "name": "Function argument and result types",
      "scope": "storage.type.method"
    },
    {
      "settings": {
        "foreground": "#B2AC77"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type.function.php"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#AB1500AD"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#000000",
        "background": "#FFDAD9"
      },
      "name": "Invalid trailing whitespace",
      "scope": "invalid.trailing-whitespace"
    },
    {
      "settings": {
        "foreground": "#699D73"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#698DC3"
      },
      "name": "Library object",
      "scope": [
        "support.class",
        "support.type",
        "entity.name"
      ]
    },
    {
      "settings": {
        "foreground": "#D48800"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#6A8DC4"
      },
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {
        "foreground": "#7B7B6E"
      },
      "name": "Markup XML declaration",
      "scope": "declaration.xml-processing"
    },
    {
      "settings": {
        "foreground": "#9A9A9A"
      },
      "name": "Markup DOCTYPE",
      "scope": "declaration.doctype"
    },
    {
      "settings": {
        "foreground": "#9A9A9A"
      },
      "name": "Markup DTD",
      "scope": "declaration.doctype.DTD"
    },
    {
      "settings": {
        "foreground": "#B67BFF"
      },
      "name": "Markup tag",
      "scope": "declaration.tag"
    },
    {
      "settings": {
        "foreground": "#B67BFF"
      },
      "name": "Markup name of tag",
      "scope": "entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#A1A9A4"
      },
      "name": "Markup tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#A1A9A480"
      },
      "name": "Punctuation",
      "scope": "punctuation"
    },
    {
      "settings": {
        "foreground": "#8A5CC4"
      },
      "name": "Inherited class name",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#00000059"
      },
      "name": "Changed files (Subversion)",
      "scope": [
        "meta.scope.changed-files.svn",
        "markup.inserted.svn",
        "markup.changed.svn",
        "markup.deleted.svn"
      ]
    },
    {
      "settings": {
        "background": "#8B928E0A"
      },
      "name": "Blocks, Expressions 1",
      "scope": "meta.section"
    },
    {
      "settings": {
        "background": "#8B928E0A"
      },
      "name": "Blocks, Expressions 2",
      "scope": "meta.section meta.section"
    },
    {
      "settings": {
        "background": "#8B928E0A"
      },
      "name": "Blocks, Expressions 3",
      "scope": "meta.section meta.section meta.section"
    }
  ]
}
