{
  "name": "Vintage Aurora",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#3D0632DE",
    "editor.foreground": "#F9EFDE",
    "editor.selectionBackground": "#673388",
    "editor.lineHighlightBackground": "#FFFFFF0F",
    "editorCursor.foreground": "#FFFFFFA6",
    "editorWhitespace.foreground": "#FFFFFF40"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#F9EFDE",
        "background": "#3D0632DE"
      }
    },
    {
      "settings": {
        "foreground": "#BCBCBC"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#DE4E96"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#FF9386"
      },
      "name": "Entity",
      "scope": "entity"
    },
    {
      "settings": {
        "foreground": "#E4C089"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#E4C089"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#65BE92"
      },
      "name": "String",
      "scope": [
        "string",
        "meta.verbatim"
      ]
    },
    {
      "settings": {
        "foreground": "#8DC4FF"
      },
      "name": "Support",
      "scope": "support"
    },
    {
      "settings": {
        "foreground": "#CABCFF"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#BB3D26",
        "fontStyle": "italic"
      },
      "name": "Invalid – Deprecated",
      "scope": "invalid.deprecated"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#AF2F1A"
      },
      "name": "Invalid – Illegal",
      "scope": "invalid.illegal"
    },
    {
      "settings": {
        "foreground": "#FF7A00",
        "fontStyle": "italic"
      },
      "name": "Superclass",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#FF7A00"
      },
      "name": "String interpolation",
      "scope": "string constant.other.placeholder"
    },
    {
      "settings": {
        "foreground": "#C9D7EB"
      },
      "name": "meta.function-call.py",
      "scope": "meta.function-call.py"
    },
    {
      "settings": {
        "foreground": "#92A2B9"
      },
      "name": "meta.tag",
      "scope": [
        "meta.tag",
        "meta.tag entity"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "entity.name.section",
      "scope": "entity.name.section"
    },
    {
      "settings": {
        "foreground": "#DDE6F6"
      },
      "name": "OCaml variant",
      "scope": "keyword.type.variant"
    },
    {
      "settings": {
        "foreground": "#F9F9F9"
      },
      "name": "OCaml operator",
      "scope": "source.ocaml keyword.operator.symbol"
    },
    {
      "settings": {
        "foreground": "#9EB6D7"
      },
      "name": "OCaml infix operator",
      "scope": "source.ocaml keyword.operator.symbol.infix"
    },
    {
      "settings": {
        "foreground": "#9EB6D7"
      },
      "name": "OCaml prefix operator",
      "scope": "source.ocaml keyword.operator.symbol.prefix"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "OCaml f-p infix operator",
      "scope": "source.ocaml keyword.operator.symbol.infix.floating-point"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "OCaml f-p prefix operator",
      "scope": "source.ocaml keyword.operator.symbol.prefix.floating-point"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "OCaml f-p constant",
      "scope": "source.ocaml constant.numeric.floating-point"
    },
    {
      "settings": {
        "background": "#FFFFFF08"
      },
      "name": "LaTeX environment",
      "scope": "text.tex.latex meta.function.environment"
    },
    {
      "settings": {
        "background": "#8CAAFB08"
      },
      "name": "LaTeX environment (nested)",
      "scope": "text.tex.latex meta.function.environment meta.function.environment"
    },
    {
      "settings": {
        "foreground": "#FCE239"
      },
      "name": "Latex support",
      "scope": "text.tex.latex support.function"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "PList unquoted string",
      "scope": [
        "source.plist string.unquoted",
        "source.plist keyword.operator"
      ]
    },
    {
      "settings": {
        "foreground": "#559F88"
      },
      "name": "String Constant",
      "scope": "string constant"
    }
  ]
}
