{
  "name": "Birds of Paradise",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#473431",
    "editor.foreground": "#EBE6CF",
    "editor.selectionBackground": "#B51C53",
    "editor.lineHighlightBackground": "#35262566",
    "editorCursor.foreground": "#E4E4E4",
    "editorWhitespace.foreground": "#6F534E"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#EBE6CF",
        "background": "#473431"
      }
    },
    {
      "settings": {
        "foreground": "#7F6041",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#7F6041",
        "fontStyle": "italic"
      },
      "name": "Python Docstring",
      "scope": "string.quoted.double.block.python"
    },
    {
      "settings": {
        "foreground": "#7EAAC7"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#F3B940"
      },
      "name": "Entity",
      "scope": "entity"
    },
    {
      "settings": {
        "foreground": "#F47440"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#F47440"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#E0DC75",
        "fontStyle": "italic"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#EBE6CF"
      },
      "name": "Support",
      "scope": "support"
    },
    {
      "settings": {
        "foreground": "#8EBCAC"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#D85840",
        "fontStyle": "italic underline"
      },
      "name": "Invalid – Deprecated",
      "scope": "invalid.deprecated"
    },
    {
      "settings": {
        "foreground": "#EBE6CF",
        "background": "#D85840"
      },
      "name": "Invalid – Illegal",
      "scope": "invalid.illegal"
    },
    {
      "settings": {},
      "name": "-----------------------------------"
    },
    {
      "settings": {
        "foreground": "#7EAAC7",
        "fontStyle": "italic"
      },
      "name": "♦ String constant",
      "scope": "string constant"
    },
    {
      "settings": {
        "foreground": "#9B70DB"
      },
      "name": "♦ String.regexp",
      "scope": "string.regexp"
    },
    {
      "settings": {
        "foreground": "#CB8EFE"
      },
      "name": "♦ String.regexp.«special»",
      "scope": [
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ]
    },
    {
      "settings": {
        "foreground": "#9BAAA6"
      },
      "name": "♦ String variable",
      "scope": "string variable"
    },
    {
      "settings": {
        "foreground": "#F3B940"
      },
      "name": "♦ Support.function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#7EAAC7"
      },
      "name": "♦ Support.constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#9AA7B7"
      },
      "name": "c C/C++ Preprocessor Line",
      "scope": "meta.preprocessor.c"
    },
    {
      "settings": {
        "foreground": "#BCCFE2"
      },
      "name": "c C/C++ Preprocessor Directive",
      "scope": "meta.preprocessor.c keyword"
    },
    {
      "settings": {
        "foreground": "#97C1C7"
      },
      "name": "✘ Doctype/XML Processing",
      "scope": [
        "meta.tag.metadata.doctype",
        "meta.tag.metadata.doctype entity",
        "meta.tag.metadata.doctype string",
        "meta.tag.metadata.processing.xml",
        "meta.tag.metadata.processing.xml entity",
        "meta.tag.metadata.processing.xml string"
      ]
    },
    {
      "settings": {
        "foreground": "#97C1C7"
      },
      "name": "✘ Meta.tag.«all»",
      "scope": [
        "declaration.tag",
        "declaration.tag entity",
        "meta.tag",
        "meta.tag entity"
      ]
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#0F2E40",
        "fontStyle": "italic"
      },
      "name": "⎇ diff.header",
      "scope": [
        "meta.diff",
        "meta.diff.header",
        "meta.separator"
      ]
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#551407"
      },
      "name": "⎇ diff.deleted",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#5C510E"
      },
      "name": "⎇ diff.changed",
      "scope": "markup.changed"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#304A2D"
      },
      "name": "⎇ diff.inserted",
      "scope": "markup.inserted"
    },
    {
      "settings": {
        "foreground": "#F47440"
      },
      "name": "SASS @import",
      "scope": "keyword.control.at-rule.sass"
    },
    {
      "settings": {
        "foreground": "#8EBCAC"
      },
      "name": "SASS $variable",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#F3B940"
      },
      "name": "SASS Attributes",
      "scope": [
        "keyword.control.untitled",
        "entity.other.attribute-name.class.sass",
        "entity.other.attribute-name.id.sass",
        "entity.other.attribute-name.tag.pseudo-class"
      ]
    },
    {
      "settings": {
        "foreground": "#EBE6CF"
      },
      "name": "SASS Properties",
      "scope": "support.type.property-name.sass"
    },
    {
      "settings": {
        "foreground": "#D1ABC7"
      },
      "name": "SASS Values",
      "scope": "support.constant.property-value.sass"
    },
    {
      "settings": {
        "foreground": "#F3B940"
      },
      "name": "CSS Attributes",
      "scope": [
        "meta.selector.css entity.name.tag",
        "meta.selector.css entity.other.attribute-name.class",
        "meta.selector.css entity.other.attribute-name.id"
      ]
    },
    {
      "settings": {
        "foreground": "#D1ABC7"
      },
      "name": "CSS Values",
      "scope": [
        "meta.property-group support.constant.property-value.css",
        "meta.property-value support.constant.property-value.css"
      ]
    },
    {
      "settings": {
        "foreground": "#7EAAC7"
      },
      "name": "CSS Constants",
      "scope": [
        "meta.property-value support.constant.named-color.css",
        "meta.property-value constant"
      ]
    }
  ]
}
