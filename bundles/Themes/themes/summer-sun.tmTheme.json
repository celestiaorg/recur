{
  "name": "Summer Sun",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#15120A",
    "editor.foreground": "#F4F8D5",
    "editor.selectionBackground": "#89826680",
    "editor.lineHighlightBackground": "#1A170B",
    "editorCursor.foreground": "#F4F8D5",
    "editorWhitespace.foreground": "#8F876B"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#F4F8D5",
        "background": "#15120A"
      }
    },
    {
      "settings": {
        "foreground": "#777259",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#B0ED60"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ]
    },
    {
      "settings": {
        "foreground": "#4CB3F1"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#47A6E3"
      },
      "name": "User-defined constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#419BD4"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#F8741D"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#F7AB1E"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#F78B24"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escape",
        "string source"
      ]
    },
    {
      "settings": {
        "foreground": "#F7AB1E"
      },
      "name": "Preprocessor line",
      "scope": "meta.preprocessor"
    },
    {
      "settings": {
        "foreground": "#F78B24"
      },
      "name": "Preprocessor directive",
      "scope": "keyword.control.import"
    },
    {
      "settings": {
        "foreground": "#8CE014"
      },
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "support.function.any-method"
      ]
    },
    {
      "settings": {
        "foreground": "#F1F7A1",
        "fontStyle": "italic"
      },
      "name": "Type name",
      "scope": "entity.name.type"
    },
    {
      "settings": {
        "foreground": "#F1F7A1",
        "fontStyle": "italic"
      },
      "name": "Inherited class name",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Function parameter",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Section",
      "scope": [
        "meta.section entity.name.section",
        "meta.function.section entity.name.section",
        "declaration.section entity.name.section"
      ]
    },
    {
      "settings": {
        "foreground": "#B0ED60"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {},
      "name": "Library object",
      "scope": [
        "support.class",
        "support.type"
      ]
    },
    {
      "settings": {
        "foreground": "#F8741D"
      },
      "name": "Library variable",
      "scope": "support.variable"
    },
    {
      "settings": {
        "background": "#F83A1F",
        "fontStyle": "italic"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "background": "#F85343",
        "fontStyle": "italic"
      },
      "name": "Invalid trailing whitespace",
      "scope": "invalid.deprecated.trailing-whitespace"
    },
    {
      "settings": {
        "foreground": "#777259"
      },
      "name": "Markup DOCTYPE",
      "scope": [
        "meta.tag.sgml.doctype",
        "meta.tag.sgml.doctype string"
      ]
    },
    {
      "settings": {
        "foreground": "#F1F7A1"
      },
      "name": "Markup tag",
      "scope": [
        "meta.tag",
        "meta.selector entity.name.tag"
      ]
    },
    {
      "settings": {
        "foreground": "#FAC500",
        "fontStyle": "italic"
      },
      "name": "Markup tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {},
      "name": "Markup property",
      "scope": "support.type.property-name"
    },
    {
      "settings": {
        "foreground": "#F8741D"
      },
      "name": "Markup constant",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.color"
      ]
    },
    {
      "settings": {
        "foreground": "#B0ED60"
      },
      "name": "Python library object",
      "scope": "meta.function-call.python support.type.python"
    }
  ]
}
