    {
      "settings": {
        "foreground": "#000000",
        "background": "#E3FEE4"
      },
      "name": "diff header to",
      "scope": "meta.diff.header.to-file"
    },
    {
      "settings": {
        "background": "#E3FEE4"
      },
      "name": "diff inserted",
      "scope": "markup.inserted.diff"
    },
    {
      "settings": {
        "foreground": "#000000",
        "background": "#FFE4E4"
      },
      "name": "diff deleted",
      "scope": "markup.deleted.diff"
    }
  ]
}
