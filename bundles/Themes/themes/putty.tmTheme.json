{
  "name": "Putty",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#302F2D",
    "editor.foreground": "#EAE7E3",
    "editor.selectionBackground": "#6D7891E0",
    "editor.lineHighlightBackground": "#424445",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#515151"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#EAE7E3",
        "background": "#302F2D"
      }
    },
    {
      "settings": {},
      "name": "source",
      "scope": "source"
    },
    {
      "settings": {
        "foreground": "#878989",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#EDF0CD"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ]
    },
    {
      "settings": {
        "foreground": "#DF6E5D"
      },
      "name": "Function (definition)",
      "scope": [
        "entity.name.function",
        "keyword.other.name-of-parameter.objc"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Class (definition)",
      "scope": "entity.name"
    },
    {
      "settings": {
        "foreground": "#FFB371"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#8BC5DF"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#8BC5DF"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#FFB371"
      },
      "name": "Constant (other variable)",
      "scope": "variable.other.constant"
    },
    {
      "settings": {
        "foreground": "#80ACCA"
      },
      "name": "Constant (built-in)",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#8BC5DF"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#DE6E5D"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#80ACCA"
      },
      "name": "Library type",
      "scope": "support.type"
    },
    {
      "settings": {
        "foreground": "#FFB371"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#EE8B6B"
      },
      "name": "Markup tag",
      "scope": [
        "meta.tag",
        "declaration.tag",
        "entity.name.tag",
        "entity.other.attribute-name"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#AB1500"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#FFB371"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "constant.character.escape",
        "string source",
        "string source.ruby"
      ]
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#3A835A"
      },
      "name": "Diff Add",
      "scope": "markup.inserted"
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#AA4F39"
      },
      "name": "Diff Remove",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "background": "#4784B9"
      },
      "name": "Diff Header",
      "scope": [
        "meta.diff.header",
        "meta.separator.diff",
        "meta.diff.index",
        "meta.diff.range"
      ]
    }
  ]
}
