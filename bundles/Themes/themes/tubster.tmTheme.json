{
  "name": "Tubster",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#2F2F2F",
    "editor.foreground": "#EBE7E3",
    "editor.selectionBackground": "#6D7891E0",
    "editor.lineHighlightBackground": "#424445",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#515151"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#2F2F2F"
      }
    },
    {
      "settings": {
        "background": "#2F2F2F"
      },
      "name": "Source",
      "scope": "source"
    },
    {
      "settings": {
        "foreground": "#797979",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#D77B42"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ]
    },
    {
      "settings": {
        "foreground": "#FFD441"
      },
      "name": "Function (definition)",
      "scope": [
        "entity.name.function",
        "keyword.other.name-of-parameter.objc"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Class (definition)",
      "scope": "entity.name"
    },
    {
      "settings": {
        "foreground": "#A8D379"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#3DAAD6"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#3EB2E1"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#D84942"
      },
      "name": "Constant (other variable)",
      "scope": "variable.other.constant"
    },
    {
      "settings": {
        "foreground": "#3DAAD6"
      },
      "name": "Constant (built-in)",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#A8D241"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#E36049"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#80ACCA"
      },
      "name": "Library type",
      "scope": "support.type"
    },
    {
      "settings": {
        "foreground": "#A8D241"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#FFD441"
      },
      "name": "Markup tag",
      "scope": [
        "meta.tag",
        "declaration.tag",
        "entity.name.tag",
        "entity.other.attribute-name"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#D81E00"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#61AC63"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "constant.character.escape",
        "string source",
        "string source.ruby"
      ]
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#78A779"
      },
      "name": "Diff Add",
      "scope": "markup.inserted"
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#AB4642"
      },
      "name": "Diff Remove",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "background": "#4180FF"
      },
      "name": "Diff Header",
      "scope": [
        "meta.diff.header",
        "meta.separator.diff",
        "meta.diff.index",
        "meta.diff.range"
      ]
    }
  ]
}
