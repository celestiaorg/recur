{
  "name": "Spectacular",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#0B0A0A",
    "editor.foreground": "#F5F5F5",
    "editor.selectionBackground": "#FFFFFF59",
    "editor.lineHighlightBackground": "#F9F9F9",
    "editorCursor.foreground": "#9CB5B6",
    "editorWhitespace.foreground": "#5A5A5A"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#F5F5F5",
        "background": "#0B0A0A"
      }
    },
    {
      "settings": {
        "foreground": "#737480",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#FF5567"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#FFF800",
        "fontStyle": "bold"
      },
      "name": "Entity",
      "scope": "entity"
    },
    {
      "settings": {
        "foreground": "#FFB700",
        "fontStyle": "bold"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#F8F192"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#B6E659"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#95CAE8"
      },
      "name": "Support",
      "scope": "support"
    },
    {
      "settings": {
        "foreground": "#FDAB5D"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#E23F0BBF"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "background": "#BEC0C614"
      },
      "name": "Embedded Source",
      "scope": "text source"
    },
    {
      "settings": {
        "background": "#BEC0C621"
      },
      "name": "Embedded Source (Bright)",
      "scope": "text.html.ruby source"
    },
    {
      "settings": {
        "foreground": "#59E374",
        "fontStyle": "italic"
      },
      "name": "Entity inherited-class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#D38DF6"
      },
      "name": "String embedded-source",
      "scope": "string.quoted source"
    },
    {
      "settings": {
        "foreground": "#AAF2AF"
      },
      "name": "String constant",
      "scope": "string constant"
    },
    {
      "settings": {
        "foreground": "#FFC066"
      },
      "name": "String.regexp",
      "scope": "string.regexp"
    },
    {
      "settings": {
        "foreground": "#F0F08F"
      },
      "name": "String variable",
      "scope": "string variable"
    },
    {
      "settings": {
        "foreground": "#FFC066"
      },
      "name": "Support.function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#F1A6AA"
      },
      "name": "Support.constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#9AA7B7"
      },
      "name": "C/C++ Preprocessor Line",
      "scope": "other.preprocessor.c"
    },
    {
      "settings": {
        "foreground": "#BCCFE2"
      },
      "name": "C/C++ Preprocessor Directive",
      "scope": "other.preprocessor.c entity"
    },
    {
      "settings": {
        "foreground": "#869390"
      },
      "name": "Doctype/XML Processing",
      "scope": [
        "declaration.sgml.html declaration.doctype",
        "declaration.sgml.html declaration.doctype entity",
        "declaration.sgml.html declaration.doctype string",
        "declaration.xml-processing",
        "declaration.xml-processing entity",
        "declaration.xml-processing string"
      ]
    },
    {
      "settings": {
        "foreground": "#ABFEFF"
      },
      "name": "Meta.tag.A",
      "scope": [
        "declaration.tag",
        "declaration.tag entity",
        "meta.tag",
        "meta.tag entity"
      ]
    },
    {
      "settings": {
        "foreground": "#ABFEFF"
      },
      "name": "css tag-name",
      "scope": "meta.selector.css entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#FFC066"
      },
      "name": "css#id",
      "scope": "meta.selector.css entity.other.attribute-name.id"
    },
    {
      "settings": {
        "foreground": "#6DE574"
      },
      "name": "css.class",
      "scope": "meta.selector.css entity.other.attribute-name.class"
    },
    {
      "settings": {
        "foreground": "#AAF2AF"
      },
      "name": "css property-name:",
      "scope": "support.type.property-name.css"
    },
    {
      "settings": {
        "foreground": "#F8F192"
      },
      "name": "css property-value;",
      "scope": [
        "meta.property-group support.constant.property-value.css",
        "meta.property-value support.constant.property-value.css"
      ]
    },
    {
      "settings": {
        "foreground": "#F9B710"
      },
      "name": "css @at-rule",
      "scope": "meta.preprocessor.at-rule keyword.control.at-rule"
    },
    {
      "settings": {
        "foreground": "#F0F192"
      },
      "name": "css additional-constants",
      "scope": [
        "meta.property-value support.constant.named-color.css",
        "meta.property-value constant"
      ]
    },
    {
      "settings": {
        "foreground": "#F1A6AA"
      },
      "name": "css constructor.argument",
      "scope": "meta.constructor.argument.css"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#0F2E40",
        "fontStyle": "italic"
      },
      "name": "diff.header",
      "scope": [
        "meta.diff",
        "meta.diff.header"
      ]
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#DB4C29"
      },
      "name": "diff.deleted",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#CFBD5C"
      },
      "name": "diff.changed",
      "scope": "markup.changed"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#4DB34F"
      },
      "name": "diff.inserted",
      "scope": "markup.inserted"
    }
  ]
}
