+        return FxHashSet::default();
+    }
+    let outer = mem::take(cx.entities.accessed_entities.get_mut());
+    paint(cx);
+    let painted = mem::replace(cx.entities.accessed_entities.get_mut(), outer);
+    cx.entities.extend_accessed(&painted);
