{
  "name": "Cobalt",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#002F51",
    "editor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#C27949BF",
    "editor.lineHighlightBackground": "#00000059",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#FFFFFF26"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#002F51"
      }
    },
    {
      "settings": {
        "foreground": "#E7F2FF"
      },
      "name": "Punctuation",
      "scope": "punctuation - (punctuation.definition.string || punctuation.definition.comment)"
    },
    {
      "settings": {
        "foreground": "#FF7C9D"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#FFE100"
      },
      "name": "Entity",
      "scope": "entity"
    },
    {
      "settings": {
        "foreground": "#FFAD00"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#FFEF92"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#40DB00"
      },
      "name": "String",
      "scope": [
        "string -string.unquoted.old-plist -string.unquoted.heredoc",
        "string.unquoted.heredoc string"
      ]
    },
    {
      "settings": {
        "foreground": "#009DFF",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#8EFCC7"
      },
      "name": "Support",
      "scope": "support"
    },
    {
      "settings": {
        "foreground": "#D6D6D6"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#FF99E7"
      },
      "name": "Lang Variable",
      "scope": "variable.language"
    },
    {
      "settings": {
        "foreground": "#FFEF92"
      },
      "name": "Function Call",
      "scope": "meta.function-call"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#941C00"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#2D4557"
      },
      "name": "Embedded Source",
      "scope": [
        "text source",
        "string.unquoted.heredoc",
        "source source"
      ]
    },
    {
      "settings": {
        "foreground": "#8EFBFF",
        "fontStyle": "italic"
      },
      "name": "Entity inherited-class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#ABFB92"
      },
      "name": "String embedded-source",
      "scope": "string.quoted source"
    },
    {
      "settings": {
        "foreground": "#8EFB94"
      },
      "name": "String constant",
      "scope": "string constant"
    },
    {
      "settings": {
        "foreground": "#8EFCCD"
      },
      "name": "String.regexp",
      "scope": "string.regexp"
    },
    {
      "settings": {
        "foreground": "#F0F08F"
      },
      "name": "String variable",
      "scope": "string variable"
    },
    {
      "settings": {
        "foreground": "#FFBD66"
      },
      "name": "Support.function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#F1A6AA"
      },
      "name": "Support.constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#FF3800"
      },
      "name": "Exception",
      "scope": "support.type.exception"
    },
    {
      "settings": {
        "foreground": "#9AA7B7"
      },
      "name": "C/C++ Preprocessor Line",
      "scope": "meta.preprocessor.c"
    },
    {
      "settings": {
        "foreground": "#BCCFE2"
      },
      "name": "C/C++ Preprocessor Directive",
      "scope": "meta.preprocessor.c keyword"
    },
    {
      "settings": {
        "foreground": "#869390"
      },
      "name": "Doctype/XML Processing",
      "scope": [
        "meta.sgml.html meta.doctype",
        "meta.sgml.html meta.doctype entity",
        "meta.sgml.html meta.doctype string",
        "meta.xml-processing",
        "meta.xml-processing entity",
        "meta.xml-processing string"
      ]
    },
    {
      "settings": {
        "foreground": "#ABFEFF"
      },
      "name": "Meta.tag.A",
      "scope": [
        "meta.tag",
        "meta.tag entity"
      ]
    },
    {
      "settings": {
        "foreground": "#ABFEFF"
      },
      "name": "css tag-name",
      "scope": "meta.selector.css entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#FFC066"
      },
      "name": "css#id",
      "scope": "meta.selector.css entity.other.attribute-name.id"
    },
    {
      "settings": {
        "foreground": "#6DE574"
      },
      "name": "css.class",
      "scope": "meta.selector.css entity.other.attribute-name.class"
    },
    {
      "settings": {
        "foreground": "#AAF2AF"
      },
      "name": "css property-name:",
      "scope": "support.type.property-name.css"
    },
    {
      "settings": {
        "foreground": "#F8F192"
      },
      "name": "css property-value;",
      "scope": [
        "meta.property-group support.constant.property-value.css",
        "meta.property-value support.constant.property-value.css"
      ]
    },
    {
      "settings": {
        "foreground": "#F9B710"
      },
      "name": "css @at-rule",
      "scope": "meta.preprocessor.at-rule keyword.control.at-rule"
    },
    {
      "settings": {
        "foreground": "#F0F192"
      },
      "name": "css additional-constants",
      "scope": [
        "meta.property-value support.constant.named-color.css",
        "meta.property-value constant"
      ]
    },
    {
      "settings": {
        "foreground": "#F1A6AA"
      },
      "name": "css constructor.argument",
      "scope": "meta.constructor.argument.css"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#001123"
      },
      "name": "diff.header",
      "scope": [
        "meta.diff",
        "meta.diff.header"
      ]
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#600E00"
      },
      "name": "diff.deleted",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#938000"
      },
      "name": "diff.changed",
      "scope": "markup.changed"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#165F00"
      },
      "name": "diff.inserted",
      "scope": "markup.inserted"
    },
    {
      "settings": {
        "background": "#9EE3F830"
      },
      "name": "Raw Markup",
      "scope": "markup.raw"
    },
    {
      "settings": {
        "background": "#005893"
      },
      "name": "Block Quote",
      "scope": "markup.quote"
    },
    {
      "settings": {
        "background": "#191133"
      },
      "name": "List",
      "scope": "markup.list"
    },
    {
      "settings": {
        "foreground": "#CDC0FF",
        "fontStyle": "bold"
      },
      "name": "Bold Markup",
      "scope": "markup.bold"
    },
    {
      "settings": {
        "foreground": "#C3FDE0",
        "fontStyle": "italic"
      },
      "name": "Italic Markup",
      "scope": "markup.italic"
    },
    {
      "settings": {
        "foreground": "#D2EAFE",
        "background": "#00172C",
        "fontStyle": "bold"
      },
      "name": "Heading Markup",
      "scope": "markup.heading"
    }
  ]
}
