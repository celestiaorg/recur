{
  "name": "RDark",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#243032",
    "editor.foreground": "#C5C9C3",
    "editor.selectionBackground": "#E6EDFF66",
    "editor.lineHighlightBackground": "#00000070",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#CBCBCB"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#C5C9C3",
        "background": "#243032"
      }
    },
    {
      "settings": {
        "foreground": "#777A76"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#69E648"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#69E648"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#69E648"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#6CB1D8"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Class name",
      "scope": "entity.name.class"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#FFB84E"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Tag name",
      "scope": "entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#999B97"
      },
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {},
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {},
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {},
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {},
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "background": "#546D7247"
      },
      "name": "Embedded Source",
      "scope": [
        "text source",
        "string.unquoted.heredoc",
        "source source"
      ]
    }
  ]
}
