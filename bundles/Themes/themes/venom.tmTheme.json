{
  "name": "Venom",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#0F0F0F",
    "editor.foreground": "#CBCBCB",
    "editor.selectionBackground": "#000000",
    "editor.lineHighlightBackground": "#212121",
    "editorCursor.foreground": "#379A4D",
    "editorWhitespace.foreground": "#000000"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#CBCBCB",
        "background": "#0F0F0F"
      }
    },
    {
      "settings": {
        "foreground": "#379A4D",
        "fontStyle": "italic"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#4D6886",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#379A4D",
        "fontStyle": "bold"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#814D8C"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#7665B7"
      },
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ]
    },
    {
      "settings": {
        "foreground": "#4D6BBE"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#7C9ACB",
        "fontStyle": "bold"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {},
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#4D6886"
      },
      "name": "Class name",
      "scope": "entity.name.class"
    },
    {
      "settings": {
        "foreground": "#B7716A"
      },
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#7660B7",
        "fontStyle": "bold"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {
        "foreground": "#B76C6F"
      },
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {},
      "name": "Tag name",
      "scope": "entity.name.tag"
    },
    {
      "settings": {},
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#515464"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {},
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#4D6886"
      },
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {},
      "name": "Invalid",
      "scope": "invalid"
    }
  ]
}
