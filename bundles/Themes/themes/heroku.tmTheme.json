{
  "name": "Heroku",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#D2E9F78F",
    "editor.lineHighlightBackground": "#202020",
    "editorCursor.foreground": "#EBEBEB",
    "editorWhitespace.foreground": "#655FA4"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#000000"
      }
    },
    {
      "settings": {
        "foreground": "#757575",
        "fontStyle": "bold italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#9D92F9",
        "fontStyle": "bold"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ]
    },
    {
      "settings": {
        "foreground": "#FF90FE"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#64B6FF"
      },
      "name": "User-defined constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#FF8373"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#64B6FF"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#CEF40E"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#FF8373"
      },
      "name": "This",
      "scope": "variable.language"
    },
    {
      "settings": {
        "foreground": "#E7F7F5"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escape",
        "string source"
      ]
    },
    {
      "settings": {
        "foreground": "#BEDB39"
      },
      "name": "Preprocessor line",
      "scope": "meta.preprocessor"
    },
    {
      "settings": {
        "foreground": "#BEDB39"
      },
      "name": "Preprocessor directive",
      "scope": "keyword.control.import"
    },
    {
      "settings": {
        "foreground": "#CAC6EC"
      },
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "support.function.any-method"
      ]
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Type name",
      "scope": "entity.name.type"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Inherited class name",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#9D92F9",
        "fontStyle": "bold"
      },
      "name": "control keyword",
      "scope": "keyword.control"
    },
    {
      "settings": {
        "foreground": "#F1F1F1"
      },
      "name": "class thing",
      "scope": "keyword.operator"
    },
    {
      "settings": {
        "foreground": "#E6F5BE"
      },
      "name": "thing",
      "scope": "storage.modifier"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Function parameter",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#838591"
      },
      "name": "Function argument and result types",
      "scope": "storage.type.method"
    },
    {
      "settings": {
        "foreground": "#E7F8FF",
        "fontStyle": "italic"
      },
      "name": "Section",
      "scope": [
        "meta.section entity.name.section",
        "declaration.section entity.name.section"
      ]
    },
    {
      "settings": {
        "foreground": "#E6F5BE"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#FFF7BD",
        "fontStyle": "bold"
      },
      "name": "Library object",
      "scope": [
        "support.class",
        "support.type"
      ]
    },
    {
      "settings": {
        "foreground": "#BEDB39"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#A9FEFF"
      },
      "name": "Library variable",
      "scope": "support.variable"
    },
    {
      "settings": {
        "foreground": "#7B8999"
      },
      "name": "JS: Operator",
      "scope": "keyword.operator.js"
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#AB1500"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#0A0B0D",
        "background": "#FFDAD9"
      },
      "name": "Invalid trailing whitespace",
      "scope": "invalid.deprecated.trailing-whitespace"
    },
    {
      "settings": {
        "background": "#20151500"
      },
      "name": "Embedded source",
      "scope": [
        "text source",
        "string.unquoted"
      ]
    },
    {
      "settings": {
        "background": "#0000000F"
      },
      "name": "Embedded embedded source",
      "scope": [
        "text source string.unquoted",
        "text source text source"
      ]
    },
    {
      "settings": {
        "foreground": "#7B7B6E"
      },
      "name": "Markup XML declaration",
      "scope": "meta.tag.preprocessor.xml"
    },
    {
      "settings": {
        "foreground": "#9A9A9A"
      },
      "name": "Markup DOCTYPE",
      "scope": [
        "meta.tag.sgml.doctype",
        "meta.tag.sgml.doctype entity",
        "meta.tag.sgml.doctype string",
        "meta.tag.preprocessor.xml",
        "meta.tag.preprocessor.xml entity",
        "meta.tag.preprocessor.xml string"
      ]
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Markup DTD",
      "scope": "string.quoted.docinfo.doctype.DTD"
    },
    {
      "settings": {
        "foreground": "#9D92F9",
        "fontStyle": "bold italic"
      },
      "name": "Markup tag",
      "scope": [
        "meta.tag",
        "declaration.tag"
      ]
    },
    {
      "settings": {
        "foreground": "#9D92F9",
        "fontStyle": "bold"
      },
      "name": "Markup name of tag",
      "scope": "entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#E6F5BE"
      },
      "name": "Markup tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#527BB0"
      },
      "name": "Markup: Heading",
      "scope": "markup.heading"
    },
    {
      "settings": {
        "foreground": "#9B856E",
        "fontStyle": "italic"
      },
      "name": "Markup: Quote",
      "scope": "markup.quote"
    },
    {
      "settings": {
        "foreground": "#C82AA1"
      },
      "name": "Markup: List",
      "scope": "markup.list"
    }
  ]
}
