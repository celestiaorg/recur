{
  "name": "choco",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#200E0D",
    "editor.foreground": "#CEC9A8",
    "editor.selectionBackground": "#E3F3FF61",
    "editor.lineHighlightBackground": "#FFAD8821",
    "editorCursor.foreground": "#B6B6B6",
    "editorWhitespace.foreground": "#FFFFFF40"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#CEC9A8",
        "background": "#200E0D"
      }
    },
    {
      "settings": {
        "foreground": "#78AA59",
        "background": "#1E2A1800"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#E36D6C"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#815E3D"
      },
      "name": "Entity",
      "scope": "entity"
    },
    {
      "settings": {
        "foreground": "#C1A36F"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#F4E9A5"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#8DB276"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#B88EAC"
      },
      "name": "Support",
      "scope": "support"
    },
    {
      "settings": {
        "foreground": "#8B9BB5"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#DBB7B0",
        "fontStyle": "italic underline"
      },
      "name": "Invalid – Deprecated",
      "scope": "invalid.deprecated"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#6A3F69BF"
      },
      "name": "Invalid – Illegal",
      "scope": "invalid.illegal"
    },
    {
      "settings": {
        "background": "#D7B17A12"
      },
      "name": "♦ Embedded Source",
      "scope": "text source"
    },
    {
      "settings": {
        "background": "#C7AC8C3B"
      },
      "name": "♦ Embedded Source (Bright)",
      "scope": "text.html.ruby source"
    },
    {
      "settings": {
        "foreground": "#AC703C"
      },
      "name": "♦ Entity inherited-class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#E1F0B2"
      },
      "name": "♦ String embedded-source",
      "scope": "string source"
    },
    {
      "settings": {
        "foreground": "#E3F3B3"
      },
      "name": "♦ String constant",
      "scope": "string constant"
    },
    {
      "settings": {
        "foreground": "#EECA75"
      },
      "name": "♦ String.regexp",
      "scope": "string.regexp"
    },
    {
      "settings": {
        "foreground": "#D99043"
      },
      "name": "♦ String.regexp.«special»",
      "scope": [
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ]
    },
    {
      "settings": {
        "foreground": "#70949F"
      },
      "name": "♦ String variable",
      "scope": "string variable"
    },
    {
      "settings": {
        "foreground": "#CEA876"
      },
      "name": "♦ Support.function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#E08774"
      },
      "name": "♦ Support.constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#9AA7B7"
      },
      "name": "c C/C++ Preprocessor Line",
      "scope": "meta.preprocessor.c"
    },
    {
      "settings": {
        "foreground": "#BCCFE2"
      },
      "name": "c C/C++ Preprocessor Directive",
      "scope": "meta.preprocessor.c keyword"
    },
    {
      "settings": {
        "foreground": "#5B5B5B"
      },
      "name": "✘ Doctype/XML Processing",
      "scope": [
        "meta.tag.sgml.doctype",
        "meta.tag.sgml.doctype entity",
        "meta.tag.sgml.doctype string",
        "meta.tag.preprocessor.xml",
        "meta.tag.preprocessor.xml entity",
        "meta.tag.preprocessor.xml string"
      ]
    },
    {
      "settings": {
        "foreground": "#AF8B6E"
      },
      "name": "✘ Meta.tag.«all»",
      "scope": [
        "declaration.tag",
        "declaration.tag entity",
        "meta.tag",
        "meta.tag entity"
      ]
    },
    {
      "settings": {
        "foreground": "#D3B386"
      },
      "name": "✘ Meta.tag.inline",
      "scope": [
        "declaration.tag.inline",
        "declaration.tag.inline entity",
        "source entity.name.tag",
        "source entity.other.attribute-name",
        "meta.tag.inline",
        "meta.tag.inline entity"
      ]
    },
    {
      "settings": {
        "foreground": "#C2A075"
      },
      "name": "§ css tag-name",
      "scope": "meta.selector.css entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#A9AB76"
      },
      "name": "§ css:pseudo-class",
      "scope": "meta.selector.css entity.other.attribute-name.tag.pseudo-class"
    },
    {
      "settings": {
        "foreground": "#88A1B3"
      },
      "name": "§ css#id",
      "scope": "meta.selector.css entity.other.attribute-name.id"
    },
    {
      "settings": {
        "foreground": "#8AB373"
      },
      "name": "§ css.class",
      "scope": "meta.selector.css entity.other.attribute-name.class"
    },
    {
      "settings": {
        "foreground": "#BDA78E"
      },
      "name": "§ css property-name:",
      "scope": "support.type.property-name.css"
    },
    {
      "settings": {
        "foreground": "#DBD4B0"
      },
      "name": "§ css property-value;",
      "scope": [
        "meta.property-group support.constant.property-value.css",
        "meta.property-value support.constant.property-value.css"
      ]
    },
    {
      "settings": {
        "foreground": "#98A4B4"
      },
      "name": "§ css @at-rule",
      "scope": "meta.preprocessor.at-rule keyword.control.at-rule"
    },
    {
      "settings": {
        "foreground": "#D56E61"
      },
      "name": "§ css additional-constants",
      "scope": [
        "meta.property-value support.constant.named-color.css",
        "meta.property-value constant"
      ]
    },
    {
      "settings": {
        "foreground": "#A0AB7D"
      },
      "name": "§ css constructor.argument",
      "scope": "meta.constructor.argument.css"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#0F2E40",
        "fontStyle": "italic"
      },
      "name": "⎇ diff.header",
      "scope": [
        "meta.diff",
        "meta.diff.header",
        "meta.separator"
      ]
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#551407"
      },
      "name": "⎇ diff.deleted",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#5C510E"
      },
      "name": "⎇ diff.changed",
      "scope": "markup.changed"
    },
    {
      "settings": {
        "foreground": "#F9F9F9",
        "background": "#304A2D"
      },
      "name": "⎇ diff.inserted",
      "scope": "markup.inserted"
    },
    {
      "settings": {
        "foreground": "#FAF0A8"
      },
      "name": "Markup: List",
      "scope": "markup.list"
    },
    {
      "settings": {
        "foreground": "#DA7F5E"
      },
      "name": "Markup: Heading",
      "scope": "markup.heading"
    }
  ]
}
