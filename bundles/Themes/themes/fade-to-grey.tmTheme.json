{
  "name": "Fade to Grey",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#5A9FE2B3",
    "editor.lineHighlightBackground": "#4A49007A",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#515151"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#000000"
      }
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#000000"
      },
      "name": "Text",
      "scope": "text"
    },
    {
      "settings": {
        "background": "#000000"
      },
      "name": "Source",
      "scope": "source"
    },
    {
      "settings": {
        "foreground": "#7C7B67"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#7C7B67",
        "background": "#171717"
      },
      "name": "Block comment",
      "scope": "comment.block"
    },
    {
      "settings": {
        "foreground": "#A5E1FF"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#DB3442"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#9B9B9B",
        "fontStyle": "bold"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#3C98C6"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#B8B8B8"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {
        "foreground": "#CECECE"
      },
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#E8E86A"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#DFE700"
      },
      "name": "Regular expression",
      "scope": "string.regexp"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Type name",
      "scope": "entity.name.type"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Class inheritance",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#4F4F4F"
      },
      "name": "Tag name",
      "scope": [
        "meta.tag",
        "meta.tag entity"
      ]
    },
    {
      "settings": {
        "foreground": "#B0B0B0"
      },
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#FFCF9F"
      },
      "name": "Tag attribute value",
      "scope": [
        "meta.attribute-with-value.id.html",
        "string.quoted.double.html"
      ]
    },
    {
      "settings": {
        "foreground": "#D5CEBE"
      },
      "name": "Support function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#FFCB86",
        "fontStyle": "bold"
      },
      "name": "Support class",
      "scope": "support.class"
    },
    {
      "settings": {
        "foreground": "#4D3E39",
        "fontStyle": "italic"
      },
      "name": "Haml Prolog Metadata",
      "scope": "punctuation.definition.prolog.haml"
    },
    {
      "settings": {
        "foreground": "#929292"
      },
      "name": "Haml Class",
      "scope": "entity.name.tag.class.haml"
    },
    {
      "settings": {
        "foreground": "#FF5964"
      },
      "name": "Haml ID",
      "scope": "entity.name.tag.id.haml"
    }
  ]
}
