{
  "name": "Text Ex Machina",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#1B1B1B",
    "editor.foreground": "#EBEBEB",
    "editor.selectionBackground": "#797979",
    "editor.lineHighlightBackground": "#4F4E41",
    "editorCursor.foreground": "#F9F9F3",
    "editorWhitespace.foreground": "#4C4A41"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#EBEBEB",
        "background": "#1B1B1B"
      }
    },
    {
      "settings": {
        "foreground": "#424242"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#76D6FF"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#BD99FF"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#BD99FF"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#BD99FF"
      },
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#8A90C0"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#414677"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#787CA8"
      },
      "name": "Storage type",
      "scope": "storage.type"
    },
    {
      "settings": {
        "foreground": "#D6D8FE",
        "fontStyle": "underline"
      },
      "name": "Class name",
      "scope": "entity.name.class"
    },
    {
      "settings": {
        "foreground": "#D6D8FE",
        "fontStyle": "italic"
      },
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#D4FB79"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {
        "foreground": "#D4FB7980",
        "fontStyle": "italic"
      },
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#414677"
      },
      "name": "Tag name",
      "scope": "entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#8A90C0"
      },
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#8EFA0080"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#46E300",
        "fontStyle": "italic"
      },
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {
        "foreground": "#F9F9F3",
        "background": "#0433FF",
        "fontStyle": "italic underline"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#F9F9F3",
        "background": "#0096FF",
        "fontStyle": "italic underline"
      },
      "name": "Invalid deprecated",
      "scope": "invalid.deprecated"
    }
  ]
}
