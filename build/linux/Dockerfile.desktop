# Throwaway Linux desktop for trying the app from a Mac (mise run linux:run):
# Xvfb + xfwm4 (it composites and supports _GTK_FRAME_EXTENTS, which GPUI needs for client-side
# decorations) + noVNC, plus GPUI's runtime libraries and Mesa's software Vulkan (Xvfb has
# no GPU). desktop-entrypoint.sh runs /srv/recur/recur.
FROM node:22.23.4-trixie-slim AS node
FROM ubuntu:24.04

# Node.js from the official image; the distro's nodejs package lags security releases.
COPY --from=node /usr/local/bin/node /usr/local/bin/node

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libgtk-4-1 libwebkitgtk-6.0-4 gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-libav \
    libxkbcommon0 libxkbcommon-x11-0 libxcb1 libwayland-client0 libvulkan1 mesa-vulkan-drivers \
    xvfb xfwm4 x11vnc novnc websockify dbus-x11 dunst libnotify-bin \
    fonts-dejavu-core ca-certificates tzdata curl git bash procps xdg-utils ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -m 1777 -p /tmp/.X11-unix \
    && userdel -r ubuntu && useradd -m -s /bin/bash dev

COPY desktop-entrypoint.sh /usr/local/bin/desktop-entrypoint
USER dev
WORKDIR /home/dev
ENV SHELL=/bin/bash \
    # Docker blocks the user namespaces WebKit's bubblewrap sandbox needs.
    WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 \
    GTK_A11Y=none
ENTRYPOINT ["/usr/local/bin/desktop-entrypoint"]
