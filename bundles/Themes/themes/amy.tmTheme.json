{
  "name": "Amy",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#2B042B",
    "editor.foreground": "#D9DAFF",
    "editor.selectionBackground": "#94110080",
    "editor.lineHighlightBackground": "#94110040",
    "editorCursor.foreground": "#838AFF",
    "editorWhitespace.foreground": "#CBCBCB"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#D9DAFF",
        "background": "#2B042B"
      }
    },
    {
      "settings": {
        "foreground": "#515493",
        "background": "#2B042B",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment.block"
    },
    {
      "settings": {
        "foreground": "#A9A9A9"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#8384A1"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#82A2BE"
      },
      "name": "Integer",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "fontStyle": "bold"
      },
      "name": "Int32 constant",
      "scope": "constant.numeric.integer.int32"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Int64 constant",
      "scope": "constant.numeric.integer.int64"
    },
    {
      "settings": {
        "fontStyle": "bold italic"
      },
      "name": "Nativeint constant",
      "scope": "constant.numeric.integer.nativeint"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Floating-point constant",
      "scope": "constant.numeric.floating-point.ocaml"
    },
    {
      "settings": {
        "foreground": "#797979"
      },
      "name": "Character constant",
      "scope": "constant.character"
    },
    {
      "settings": {
        "foreground": "#9293B0"
      },
      "name": "Boolean constant",
      "scope": "constant.language.boolean"
    },
    {
      "settings": {},
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {},
      "name": "User-defined constant",
      "scope": "constant.other"
    },
    {
      "settings": {
        "foreground": "#009192"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#B098FF"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#B0B3FF"
      },
      "name": "Keyword operator",
      "scope": "keyword.operator"
    },
    {
      "settings": {
        "foreground": "#D9DAFF"
      },
      "name": "Keyword decorator",
      "scope": "keyword.other.decorator"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Floating-point infix operator",
      "scope": "keyword.operator.infix.floating-point.ocaml"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Floating-point prefix operator",
      "scope": "keyword.operator.prefix.floating-point.ocaml"
    },
    {
      "settings": {
        "foreground": "#CD96CB"
      },
      "name": "Compiler directives",
      "scope": "keyword.other.directive"
    },
    {
      "settings": {
        "foreground": "#CD96CB",
        "fontStyle": "underline"
      },
      "name": "Line-number directives",
      "scope": "keyword.other.directive.line-number"
    },
    {
      "settings": {
        "foreground": "#92B2FF"
      },
      "name": "Control keyword",
      "scope": "keyword.control"
    },
    {
      "settings": {
        "foreground": "#BCFEF3"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#71BFFF"
      },
      "name": "Variants",
      "scope": "entity.name.type.variant"
    },
    {
      "settings": {
        "foreground": "#71BFFF",
        "fontStyle": "italic"
      },
      "name": "Polymorphic variants",
      "scope": [
        "storage.type.variant.polymorphic",
        "entity.name.type.variant.polymorphic"
      ]
    },
    {
      "settings": {
        "foreground": "#C02DBE"
      },
      "name": "Module definitions",
      "scope": "entity.name.type.module"
    },
    {
      "settings": {
        "foreground": "#C02DBE",
        "fontStyle": "underline"
      },
      "name": "Module type definitions",
      "scope": "entity.name.type.module-type.ocaml"
    },
    {
      "settings": {
        "foreground": "#B21D63"
      },
      "name": "Support modules",
      "scope": "support.other"
    },
    {
      "settings": {
        "foreground": "#7FE392"
      },
      "name": "Class name",
      "scope": "entity.name.type.class"
    },
    {
      "settings": {
        "foreground": "#7FE3B0"
      },
      "name": "Class type",
      "scope": "entity.name.type.class-type"
    },
    {
      "settings": {},
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#60AFB0"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {
        "foreground": "#91BDBE"
      },
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#3B92B0"
      },
      "name": "Token definition (ocamlyacc)",
      "scope": "entity.name.type.token"
    },
    {
      "settings": {
        "foreground": "#47BDD9"
      },
      "name": "Token reference (ocamlyacc)",
      "scope": "entity.name.type.token.reference"
    },
    {
      "settings": {
        "foreground": "#9FE5E6"
      },
      "name": "Non-terminal definition (ocamlyacc)",
      "scope": "entity.name.function.non-terminal"
    },
    {
      "settings": {
        "foreground": "#CAF2F3"
      },
      "name": "Non-terminal reference (ocamlyacc)",
      "scope": "entity.name.function.non-terminal.reference"
    },
    {
      "settings": {
        "foreground": "#00A0A1"
      },
      "name": "Tag name",
      "scope": "entity.name.tag"
    },
    {
      "settings": {},
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "background": "#2B042B"
      },
      "name": "Library function"
    },
    {
      "settings": {
        "background": "#2B042B"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {},
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {
        "foreground": "#521B93",
        "background": "#FFFB00",
        "fontStyle": "bold"
      },
      "name": "Invalid - illegal",
      "scope": "invalid.illegal"
    },
    {
      "settings": {
        "foreground": "#2B042B",
        "background": "#D783FF"
      },
      "name": "Invalid - depricated",
      "scope": "invalid.deprecated"
    },
    {
      "settings": {
        "background": "#521B9354"
      },
      "name": "Camlp4 code",
      "scope": "source.camlp4.embedded"
    },
    {
      "settings": {},
      "name": "Camlp4 temp (parser)",
      "scope": "source.camlp4.embedded.parser.ocaml"
    },
    {
      "settings": {
        "foreground": "#936692"
      },
      "name": "Punctuation",
      "scope": "punctuation"
    }
  ]
}
