{
  "name": "Ryan Light",
  "type": "light",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editor.selectionBackground": "#CDE3FF",
    "editor.lineHighlightBackground": "#F2F2F2",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#CBCBCB"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000",
        "background": "#FFFFFF"
      }
    },
    {
      "settings": {
        "foreground": "#929292",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#007A06"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ]
    },
    {
      "settings": {
        "foreground": "#9625A6"
      },
      "name": "Function (definition)",
      "scope": [
        "entity.name.function",
        "keyword.other.name-of-parameter.objc"
      ]
    },
    {
      "settings": {
        "foreground": "#0A2ADC"
      },
      "name": "Class (definition)",
      "scope": "entity.name"
    },
    {
      "settings": {
        "foreground": "#0B2ADC"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#924800"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#B73E36"
      },
      "name": "Constant",
      "scope": [
        "constant",
        "variable.other.constant"
      ]
    },
    {
      "settings": {
        "foreground": "#0329D7"
      },
      "name": "Constant (built-in)",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#009DA1"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#012195"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#007A07"
      },
      "name": "Library type",
      "scope": "support.type"
    },
    {
      "settings": {
        "foreground": "#007A07"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#3B59AB"
      },
      "name": "Markup tag",
      "scope": [
        "meta.tag",
        "declaration.tag",
        "entity.name.tag",
        "entity.other.attribute-name"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#AB1500"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#000000",
        "background": "#FFFAE4"
      },
      "name": "Embedded Ruby Source",
      "scope": "text source.ruby"
    },
    {
      "settings": {
        "foreground": "#26BC22"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "constant.character.escape",
        "string source",
        "string source.ruby"
      ]
    }
  ]
}
