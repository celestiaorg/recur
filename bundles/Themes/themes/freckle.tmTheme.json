{
  "name": "Freckle",
  "type": "light",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editor.selectionBackground": "#B8E0E8",
    "editor.lineHighlightBackground": "#424445",
    "editorCursor.foreground": "#40A3B7",
    "editorWhitespace.foreground": "#515151"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000",
        "background": "#FFFFFF"
      }
    },
    {
      "settings": {},
      "name": "Source",
      "scope": "source"
    },
    {
      "settings": {
        "foreground": "#8C8E87",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#EF5F92"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ]
    },
    {
      "settings": {
        "foreground": "#40A3B7",
        "fontStyle": "bold"
      },
      "name": "Function (definition)",
      "scope": [
        "entity.name.function",
        "keyword.other.name-of-parameter.objc"
      ]
    },
    {
      "settings": {
        "foreground": "#3CC5DE"
      },
      "name": "Class (definition)",
      "scope": "entity.name"
    },
    {
      "settings": {
        "foreground": "#4B4C48"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#40A3B7"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#40A3B7",
        "background": "#B5E0E8"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#40A3B7"
      },
      "name": "Constant (other variable)",
      "scope": "variable.other.constant"
    },
    {
      "settings": {
        "foreground": "#3CC5DE"
      },
      "name": "Constant (built-in)",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#797C74",
        "background": "#DBF1AA"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#EF5F92"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#40A3B7"
      },
      "name": "Library type",
      "scope": "support.type"
    },
    {
      "settings": {
        "foreground": "#8BC402"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#3CC5DE"
      },
      "name": "Markup tag",
      "scope": [
        "meta.tag",
        "declaration.tag",
        "entity.name.tag",
        "entity.other.attribute-name"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#FF377B"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#797C74"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "constant.character.escape",
        "string source",
        "string source.ruby"
      ]
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#65A92A"
      },
      "name": "Diff Add",
      "scope": "markup.inserted"
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#FF377B"
      },
      "name": "Diff Remove",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "background": "#40A3B7"
      },
      "name": "Diff Header",
      "scope": [
        "meta.diff.header",
        "meta.separator.diff",
        "meta.diff.index",
        "meta.diff.range"
      ]
    }
  ]
}
