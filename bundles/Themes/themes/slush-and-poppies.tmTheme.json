{
  "name": "Slush & Poppies",
  "type": "light",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#F4F4F4",
    "editor.foreground": "#000000",
    "editor.selectionBackground": "#BEC0FF",
    "editor.lineHighlightBackground": "#00000026",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#CBCBCB"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000",
        "background": "#F4F4F4"
      }
    },
    {
      "settings": {
        "foreground": "#507251"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#CD453E"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#0092B0"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "OCaml floating-point constants",
      "scope": "source.ocaml constant.numeric.floating-point"
    },
    {
      "settings": {
        "foreground": "#941100"
      },
      "name": "Character constants",
      "scope": "constant.character"
    },
    {
      "settings": {},
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {},
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ]
    },
    {
      "settings": {},
      "name": "Variable",
      "scope": [
        "variable.parameter",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#2775B0"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#2775B0"
      },
      "name": "Operators",
      "scope": "keyword.operator"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "OCaml prefix f-p operators",
      "scope": "source.ocaml keyword.operator.symbol.prefix.floating-point"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "OCaml infix f-p operators",
      "scope": "source.ocaml keyword.operator.symbol.infix.floating-point"
    },
    {
      "settings": {
        "foreground": "#0096FF"
      },
      "name": "Module Keyword",
      "scope": [
        "entity.name.module",
        "support.other.module"
      ]
    },
    {
      "settings": {
        "foreground": "#B09100"
      },
      "name": "Storage types",
      "scope": "storage.type"
    },
    {
      "settings": {
        "foreground": "#009192"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#CD9373"
      },
      "name": "Variant types",
      "scope": "entity.name.class.variant"
    },
    {
      "settings": {
        "fontStyle": "bold"
      },
      "name": "Directives",
      "scope": "keyword.other.directive"
    },
    {
      "settings": {},
      "name": "Line-number directives",
      "scope": "source.ocaml keyword.other.directive.line-number"
    },
    {
      "settings": {},
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#941100"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {
        "foreground": "#942192"
      },
      "name": "Type name",
      "scope": "storage.type.user-defined"
    },
    {
      "settings": {
        "foreground": "#942CCC"
      },
      "name": "Class type name",
      "scope": "entity.name.type.class.type"
    },
    {
      "settings": {},
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {},
      "name": "Tag name",
      "scope": "entity.name.tag"
    },
    {
      "settings": {},
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {},
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {},
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {},
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Library variable",
      "scope": "support.variable"
    },
    {
      "settings": {},
      "name": "Invalid",
      "scope": "invalid"
    }
  ]
}
