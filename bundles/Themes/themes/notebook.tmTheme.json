{
  "name": "Notebook",
  "type": "light",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#CAC2AD",
    "editor.foreground": "#000000BF",
    "editor.selectionBackground": "#FFFFFFDB",
    "editor.lineHighlightBackground": "#FFFFFF29",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#97846840"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000BF",
        "background": "#CAC2AD"
      }
    },
    {
      "settings": {
        "foreground": "#FFF1D780",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#FFFFFF4D"
      },
      "name": "Punctuation",
      "scope": "punctuation.section.embedded"
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#EEDE37BF"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#000000BF",
        "background": "#A7FA53BF"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#74DEEBBF"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#74DEEBBF"
      },
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ]
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#78A2655C"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#D23C33"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#9EE9DBBF"
      },
      "name": "Entity",
      "scope": "constant.character.entity"
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#B5AC98BF"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#264BA0"
      },
      "name": "Class name",
      "scope": [
        "entity.name.type.class",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {},
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#000000BF",
        "background": "#BFB4A0BF"
      },
      "name": "Tag name",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ]
    },
    {
      "settings": {
        "fontStyle": "underline"
      },
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#FFFFFF1A",
        "background": "#FD70AB6E"
      },
      "name": "Library function",
      "scope": [
        "support.function",
        "support.constant.property-value.css"
      ]
    },
    {
      "settings": {},
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {},
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#CD4C4B"
      },
      "name": "Invalid",
      "scope": "invalid"
    }
  ]
}
