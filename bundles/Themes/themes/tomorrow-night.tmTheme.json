{
  "name": "Tomorrow Night",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#27292C",
    "editor.foreground": "#D0D2D0",
    "editor.selectionBackground": "#474C52",
    "editor.lineHighlightBackground": "#35383C",
    "editorCursor.foreground": "#BCBDBB",
    "editorWhitespace.foreground": "#5D6168"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#D0D2D0",
        "background": "#27292C"
      }
    },
    {
      "settings": {
        "foreground": "#A7A8A7"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#D7DAD8"
      },
      "name": "Foreground",
      "scope": [
        "keyword.operator.class",
        "constant.other",
        "source.php.embedded.line"
      ]
    },
    {
      "settings": {
        "foreground": "#D77C79"
      },
      "name": "Variable, String Link, Regular Expression, Tag Name",
      "scope": [
        "variable",
        "support.other.variable",
        "string.other.link",
        "string.regexp",
        "entity.name.tag",
        "entity.other.attribute-name"
      ]
    },
    {
      "settings": {
        "foreground": "#E6A472"
      },
      "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "variable.parameter",
        "punctuation.section.embedded",
        "keyword.other.unit"
      ]
    },
    {
      "settings": {
        "foreground": "#F4CF87"
      },
      "name": "Class, Support",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {
        "foreground": "#C2C77B"
      },
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "entity.other.inherited-class",
        "markup.heading"
      ]
    },
    {
      "settings": {
        "foreground": "#9AC9C4"
      },
      "name": "Operator, Misc",
      "scope": [
        "keyword.operator",
        "constant.other.color"
      ]
    },
    {
      "settings": {
        "foreground": "#92B2CA"
      },
      "name": "Function, Special Method, Block Level",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method",
        "meta.block-level"
      ]
    },
    {
      "settings": {
        "foreground": "#C0A7C7"
      },
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "entity.name.tag.css"
      ]
    },
    {
      "settings": {
        "foreground": "#D7DAD8",
        "background": "#E77672"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#D7DAD8",
        "background": "#93B3CB"
      },
      "name": "Separator",
      "scope": "meta.separator"
    },
    {
      "settings": {
        "foreground": "#D7DAD8",
        "background": "#C4AACB"
      },
      "name": "Deprecated",
      "scope": "invalid.deprecated"
    }
  ]
}
