{
  "name": "Espresso Tutti",
  "type": "light",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editor.selectionBackground": "#90D2FF",
    "editor.lineHighlightBackground": "#CCE8FA",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#515151"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000",
        "background": "#FFFFFF"
      }
    },
    {
      "settings": {
        "foreground": "#000000"
      },
      "name": "Source",
      "scope": "source"
    },
    {
      "settings": {
        "foreground": "#B8B8B8"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#3B83AF",
        "background": "#F6FBFF"
      },
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage"
      ]
    },
    {
      "settings": {
        "foreground": "#4B2F85"
      },
      "name": "Function (definition)",
      "scope": [
        "entity.name.function",
        "keyword.other.name-of-parameter.objc"
      ]
    },
    {
      "settings": {
        "foreground": "#DE6062"
      },
      "name": "Class (definition)",
      "scope": "entity.name"
    },
    {
      "settings": {
        "foreground": "#040506",
        "fontStyle": "bold italic"
      },
      "name": "Class inheritence",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#623EAA"
      },
      "name": "Support",
      "scope": "support"
    },
    {
      "settings": {
        "foreground": "#DA6672"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#8D9C5F"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#8A6CCC",
        "background": "#F5F5FF"
      },
      "name": "Constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#8A6CCC",
        "background": "#F5F5FF"
      },
      "name": "Constant (other variable)",
      "scope": "variable.other.constant"
    },
    {
      "settings": {
        "foreground": "#8A6CCD",
        "background": "#F5F5FF"
      },
      "name": "Constant (built-in)",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#84BA06",
        "background": "#FFFFFF"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#E12D01"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#0367B5"
      },
      "name": "Library type",
      "scope": "support.type"
    },
    {
      "settings": {
        "foreground": "#3B83AF",
        "background": "#F7FBFF"
      },
      "name": "Markup tag",
      "scope": [
        "entity.name.tag",
        "declaration.tag"
      ]
    },
    {
      "settings": {
        "foreground": "#5FAFD8"
      },
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#DE6062"
      },
      "name": "Tag String",
      "scope": "string.quoted.double.html"
    },
    {
      "settings": {
        "foreground": "#5FAFEF"
      },
      "name": "Meta Tag",
      "scope": "meta.tag"
    },
    {
      "settings": {
        "foreground": "#FAF4D7",
        "background": "#FD4B40"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#000000",
        "background": "#ECFEDD"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "constant.character.escape",
        "string source",
        "string source.ruby"
      ]
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#91D2FF"
      },
      "name": "Diff Add",
      "scope": "markup.inserted"
    },
    {
      "settings": {
        "foreground": "#EBE7E3",
        "background": "#DC4D4D"
      },
      "name": "Diff Remove",
      "scope": "markup.deleted"
    },
    {
      "settings": {
        "background": "#75B792"
      },
      "name": "Diff Header",
      "scope": [
        "meta.diff.header",
        "meta.separator.diff",
        "meta.diff.index",
        "meta.diff.range"
      ]
    },
    {
      "settings": {
        "foreground": "#3B83AF"
      },
      "name": "CSS Selector",
      "scope": [
        "meta.selector.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.name.tag.wildcard.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.class.css"
      ]
    },
    {
      "settings": {
        "foreground": "#D4430D"
      },
      "name": "CSS Property",
      "scope": "support.type.property-name.css"
    },
    {
      "settings": {
        "foreground": "#43A203",
        "background": "#FFFFFF"
      },
      "name": "CSS Other",
      "scope": [
        "keyword.other.unit.css",
        "constant.other.rgb-value.css",
        "constant.numeric.css"
      ]
    },
    {
      "settings": {
        "foreground": "#43A203"
      },
      "name": "CSS Constant",
      "scope": [
        "support.constant.font-name.css",
        "constant.other.color.rgb-value.css"
      ]
    }
  ]
}
