{
  "name": "Juicy",
  "type": "light",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#F4F4F4",
    "editor.foreground": "#000000",
    "editor.selectionBackground": "#B7D4FF",
    "editor.lineHighlightBackground": "#00000012",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#CBCBCB"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000",
        "background": "#F4F4F4"
      }
    },
    {
      "settings": {
        "foreground": "#A9A9A9",
        "fontStyle": "italic"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {},
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#FF7C00"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#37D100"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {},
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {},
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ]
    },
    {
      "settings": {
        "foreground": "#00AAD6"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#AB4500"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {},
      "name": "Class name",
      "scope": "entity.name.class"
    },
    {
      "settings": {},
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#FF2600"
      },
      "name": "Function name",
      "scope": "entity.name.function"
    },
    {
      "settings": {},
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#FF2600"
      },
      "name": "Tag name",
      "scope": "entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#AB4500"
      },
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#D81E00"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#407AAA"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#00AAD6"
      },
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {
        "background": "#FF2600"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#407AAA"
      },
      "name": "Constant",
      "scope": "constant"
    }
  ]
}
