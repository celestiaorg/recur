diff --git a/rust/vendor/gpui-pre-macos/src/window.rs b/rust/vendor/gpui-pre-macos/src/window.rs
index b0428255..38ff28a8 100644
--- a/rust/vendor/gpui-pre-macos/src/window.rs
+++ b/rust/vendor/gpui-pre-macos/src/window.rs
@@ -2562,6 +2562,25 @@ extern "C" fn reset_cursor_rects(this: &Object, _: Sel) {
             CursorStyle::DragLink => msg_send![class!(NSCursor), dragLinkCursor],
             CursorStyle::DragCopy => msg_send![class!(NSCursor), dragCopyCursor],
             CursorStyle::ContextualMenu => msg_send![class!(NSCursor), contextualMenuCursor],
+            // macOS 15+; earlier releases fall back to the pointing hand and the arrow.
+            CursorStyle::ZoomIn => {
+                let has_zoom: BOOL =
+                    msg_send![class!(NSCursor), respondsToSelector: sel!(zoomInCursor)];
+                if has_zoom == YES {
+                    msg_send![class!(NSCursor), zoomInCursor]
+                } else {
+                    msg_send![class!(NSCursor), pointingHandCursor]
+                }
+            }
+            CursorStyle::ZoomOut => {
+                let has_zoom: BOOL =
+                    msg_send![class!(NSCursor), respondsToSelector: sel!(zoomOutCursor)];
+                if has_zoom == YES {
+                    msg_send![class!(NSCursor), zoomOutCursor]
+                } else {
+                    msg_send![class!(NSCursor), arrowCursor]
+                }
+            }
         };
 
         let bounds = NSView::bounds(this as *const Object as id);
