{
  "name": "Fluidvision",
  "type": "light",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#F6F6F6F2",
    "editor.foreground": "#000000",
    "editor.selectionBackground": "#FFDEA4",
    "editor.lineHighlightBackground": "#00000012",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#CBCBCB"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#000000",
        "background": "#F6F6F6F2"
      }
    },
    {
      "settings": {
        "foreground": "#4682A1",
        "background": "#E3F2FEF2"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#295E9F",
        "fontStyle": "italic"
      },
      "name": "Variable",
      "scope": "variable"
    },
    {
      "settings": {
        "foreground": "#6DA4E7",
        "fontStyle": "bold"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#D06406",
        "fontStyle": "bold"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#D21F08",
        "fontStyle": "italic"
      },
      "name": "User-defined constant",
      "scope": "constant"
    },
    {
      "settings": {
        "foreground": "#6B77F8",
        "fontStyle": "italic"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#981B0A"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#26BC22"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "constant.character.escape",
        "string source"
      ]
    },
    {
      "settings": {
        "foreground": "#149F25"
      },
      "name": "Preprocessor line",
      "scope": "other.preprocessor"
    },
    {
      "settings": {
        "foreground": "#05550E",
        "fontStyle": "bold"
      },
      "name": "Preprocessor directive",
      "scope": "entity.name.preprocessor"
    },
    {
      "settings": {
        "foreground": "#2161AD",
        "fontStyle": "bold"
      },
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "keyword.other.name-of-parameter.objc"
      ]
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Class name",
      "scope": "entity.name.class"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Inherited class name",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Function parameter",
      "scope": "variable.parameter"
    },
    {
      "settings": {
        "foreground": "#838591"
      },
      "name": "Function argument and result types",
      "scope": "storage.type.method"
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Section",
      "scope": [
        "meta.section entity.name.section",
        "declaration.section entity.name.section"
      ]
    },
    {
      "settings": {
        "foreground": "#4C6085",
        "fontStyle": "bold"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {
        "foreground": "#3A698C",
        "fontStyle": "bold"
      },
      "name": "Library object",
      "scope": [
        "support.class",
        "support.type"
      ]
    },
    {
      "settings": {
        "foreground": "#72A724",
        "fontStyle": "bold"
      },
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {
        "foreground": "#2B59AC",
        "fontStyle": "bold"
      },
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {
        "foreground": "#7B8999"
      },
      "name": "JS: Operator",
      "scope": "keyword.operator.js"
    },
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#AB1500"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "background": "#FFDAD9"
      },
      "name": "Invalid trailing whitespace",
      "scope": "invalid.trailing-whitespace"
    },
    {
      "settings": {
        "background": "#5295F730"
      },
      "name": "Embedded source",
      "scope": [
        "text source",
        "string.unquoted"
      ]
    },
    {
      "settings": {
        "foreground": "#7B7B6E"
      },
      "name": "Markup XML declaration",
      "scope": [
        "meta.xml-processing",
        "declaration.xml-processing"
      ]
    },
    {
      "settings": {
        "foreground": "#9A9A9A"
      },
      "name": "Markup DOCTYPE",
      "scope": [
        "meta.doctype",
        "declaration.doctype"
      ]
    },
    {
      "settings": {
        "fontStyle": "italic"
      },
      "name": "Markup DTD",
      "scope": [
        "meta.doctype.DTD",
        "declaration.doctype.DTD"
      ]
    },
    {
      "settings": {
        "foreground": "#244D93"
      },
      "name": "Markup tag",
      "scope": [
        "meta.tag",
        "declaration.tag"
      ]
    },
    {
      "settings": {
        "foreground": "#002A69",
        "fontStyle": "bold"
      },
      "name": "Markup name of tag",
      "scope": "entity.name.tag"
    },
    {
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      },
      "name": "Markup tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#1134FF",
        "fontStyle": "bold"
      },
      "name": "Markup: Heading",
      "scope": "markup.heading"
    },
    {
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      },
      "name": "Markup: Quote",
      "scope": "markup.quote"
    },
    {
      "settings": {
        "foreground": "#C82AA1"
      },
      "name": "Markup: List",
      "scope": "markup.list"
    }
  ]
}
