{
  "name": "Sidewalk Chalk",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#393B3C",
    "editor.foreground": "#FBFBFB",
    "editor.selectionBackground": "#D0D0D08F",
    "editor.lineHighlightBackground": "#00000012",
    "editorCursor.foreground": "#919191",
    "editorWhitespace.foreground": "#656565"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#FBFBFB",
        "background": "#393B3C"
      }
    },
    {
      "settings": {
        "foreground": "#666666",
        "background": "#2C2D2F"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#719BC5",
        "background": "#000E3C40"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#EADE48"
      },
      "name": "Number",
      "scope": "constant.numeric"
    },
    {
      "settings": {
        "foreground": "#DF8231"
      },
      "name": "Built-in constant",
      "scope": "constant.language"
    },
    {
      "settings": {
        "foreground": "#EADE48"
      },
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ]
    },
    {
      "settings": {
        "foreground": "#65B8E2"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#72C35F"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {},
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {},
      "name": "Class name",
      "scope": "entity.name.class"
    },
    {
      "settings": {},
      "name": "Inherited class",
      "scope": "entity.other.inherited-class"
    },
    {
      "settings": {
        "foreground": "#B2B2B2"
      },
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "keyword.operator",
        "keyword.other.name-of-parameter"
      ]
    },
    {
      "settings": {},
      "name": "Function argument",
      "scope": "variable.parameter"
    },
    {
      "settings": {},
      "name": "Tag name",
      "scope": "entity.name.tag"
    },
    {
      "settings": {},
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name"
    },
    {
      "settings": {
        "foreground": "#73FCD6"
      },
      "name": "Library function",
      "scope": "support.function"
    },
    {
      "settings": {},
      "name": "Library constant",
      "scope": "support.constant"
    },
    {
      "settings": {},
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ]
    },
    {
      "settings": {},
      "name": "Library variable",
      "scope": "support.other.variable"
    },
    {
      "settings": {},
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#719BC5"
      },
      "name": "Library object",
      "scope": [
        "support.class",
        "support.type",
        "entity.name"
      ]
    },
    {
      "settings": {
        "background": "#001E3940"
      },
      "name": "Embedded code",
      "scope": [
        "string.unquoted.embedded",
        "text source",
        "string.unquoted"
      ]
    },
    {
      "settings": {
        "foreground": "#A9A9A9"
      },
      "name": "String interpolation",
      "scope": [
        "constant.character.escaped",
        "string source - string.unquoted.embedded",
        "string string source"
      ]
    }
  ]
}
