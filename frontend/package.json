{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build:debug": "vite build --minify false --sourcemap --mode production",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:seed": "cd .. && go run ./cmd/seeddump > frontend/e2e/fixtures/seed.json",
    "update-file-icons": "node scripts/update-file-icons.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@wailsio/runtime": "3.0.0-beta.24",
    "@xterm/addon-fit": "^0.12.0-beta.301",
    "@xterm/addon-search": "^0.17.0-beta.301",
    "@xterm/addon-web-links": "^0.13.0-beta.301",
    "@xterm/addon-webgl": "^0.20.0-beta.300",
    "@xterm/xterm": "^6.1.0-beta.304",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "lucide": "^1.33.0",
    "marked": "^18.0.7",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^6.3.289",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "happy-dom": "^20.11.2",
    "less": "^4.8.1",
    "sass": "^1.103.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.8",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^8.0.5",
    "vitest": "^5.0.3"
  }
}
