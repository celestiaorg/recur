{
  "name": "Happydeluxe",
  "type": "dark",
  "colorSpaceName": "sRGB",
  "colors": {
    "editor.background": "#101928",
    "editor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#1B386D",
    "editor.lineHighlightBackground": "#00000078",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#777B84"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#101928"
      }
    },
    {
      "settings": {
        "foreground": "#445D8F"
      },
      "name": "Comment",
      "scope": "comment"
    },
    {
      "settings": {
        "foreground": "#FF84FA"
      },
      "name": "String",
      "scope": "string"
    },
    {
      "settings": {
        "foreground": "#FFFFFF"
      },
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ]
    },
    {
      "settings": {
        "foreground": "#FFA100"
      },
      "name": "Keyword",
      "scope": "keyword"
    },
    {
      "settings": {
        "foreground": "#FFA100"
      },
      "name": "Storage",
      "scope": "storage"
    },
    {
      "settings": {
        "foreground": "#FF4600"
      },
      "name": "Invalid",
      "scope": "invalid"
    },
    {
      "settings": {
        "foreground": "#00E2DA"
      },
